	/// Site at the extraction date
	column current_site_code
		dataType: string
		lineageTag: 77b1f289-319b-50e7-b8e9-8654b5900786
		summarizeBy: none
		sourceColumn: current_site_code

		annotation SummarizationSetBy = User

	/// PERSG at the extraction date
	column current_employee_group_code
		dataType: string
		lineageTag: 860300d7-aed9-502e-9257-4ab5f687b075
		summarizeBy: none
		sourceColumn: current_employee_group_code

		annotation SummarizationSetBy = User

	/// PERSK at the extraction date
	column current_employee_subgroup_code
		dataType: string
		lineageTag: 73fc7c24-e033-5f7e-9c19-2f57ebc89b11
		summarizeBy: none
		sourceColumn: current_employee_subgroup_code

