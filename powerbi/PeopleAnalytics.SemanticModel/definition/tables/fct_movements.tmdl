		sourceColumn: is_resignation

		annotation SummarizationSetBy = User

	/// +1 entry or transfer in, -1 exit or transfer out, 0 otherwise
	column headcount_delta
		dataType: int64
		isHidden
		lineageTag: 85b6c9ec-ebb5-5197-93ac-8108f67a9375
		summarizeBy: none
