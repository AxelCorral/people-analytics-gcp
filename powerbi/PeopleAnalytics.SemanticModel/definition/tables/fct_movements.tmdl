		annotation SummarizationSetBy = User

	partition fct_movements = m
		mode: import
		source =
			let
			    Source = LoadMart("fct_movements"),
			    Typed = Table.TransformColumnTypes(Source, {{"movement_id", type text}, {"event_date", type date}, {"month_start", type date}, {"employee_id", type text}, {"movement_type", type text}, {"action_key", type text}, {"org_unit_id", type text}, {"site_code", type text}, {"employee_group_code", type text}, {"employee_subgroup_code", type text}, {"is_entry", type logical}, {"is_exit", type logical}, {"is_cdi_exit", type logical}, {"is_resignation", type logical}, {"headcount_delta", Int64.Type}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
