		sourceColumn: event_date

		annotation SummarizationSetBy = User

	/// First day of the event month (relationship key to dim_date)
	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		isHidden
		lineageTag: 0936e9ae-bafd-5156-8d37-a0cf7a61985a
		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = User

	/// Personnel number
	column employee_id
