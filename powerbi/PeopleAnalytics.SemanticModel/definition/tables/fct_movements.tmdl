/// Workforce movements in the reporting window: hires, rehires, exits (dated on the last worked day), transfers (one row out, one row in), promotions and contract changes. Department and contract are those of the event day (last worked day for an exit).
table fct_movements
	lineageTag: a511ea6b-16a3-5cb3-a79e-676a9e4cf746

	/// Entrées : embauches et réintégrations.
	measure Hires =
			CALCULATE ( COUNTROWS ( fct_movements ), fct_movements[is_entry] = TRUE () )
		formatString: #,0
		displayFolder: Mouvements
		lineageTag: b25d7581-c1c6-56fd-aad1-6546eb9351a4

	/// Sorties, datées du dernier jour travaillé.
	measure Exits =
			CALCULATE ( COUNTROWS ( fct_movements ), fct_movements[is_exit] = TRUE () )
		formatString: #,0
		displayFolder: Mouvements
		lineageTag: cecceb2f-547b-53f5-aa92-194985e469ee

	/// Sorties de salariés en CDI, toutes causes.
	measure 'Exits CDI' =
			CALCULATE ( COUNTROWS ( fct_movements ), fct_movements[is_cdi_exit] = TRUE () )
		formatString: #,0
		displayFolder: Mouvements
		lineageTag: 338fc384-e060-5e0e-8eff-140beb5669a6

	/// Démissions de salariés en CDI.
	measure 'Resignations CDI' =
			CALCULATE ( COUNTROWS ( fct_movements ), fct_movements[is_cdi_exit] = TRUE (), fct_movements[is_resignation] = TRUE () )
		formatString: #,0
		displayFolder: Mouvements
		lineageTag: 6e448645-031b-5bc7-a29d-f39fd3de5dfd

	/// Indicateur principal : sorties de CDI toutes causes sur 12 mois / effectif moyen CDI sur 12 mois. Fins de CDD exclues.
	measure 'Turnover CDI 12M %' =
			VAR _end = MAX ( dim_date[month_start] )
			VAR _start = EDATE ( _end, -11 )
			VAR _exits =
			    CALCULATE ( [Exits CDI], REMOVEFILTERS ( dim_date ), dim_date[month_start] >= _start, dim_date[month_start] <= _end )
			RETURN
			    DIVIDE ( _exits, [Avg Headcount CDI 12M] )
		formatString: 0.0 %
		displayFolder: Mouvements
		lineageTag: 6b1e53aa-4ea9-590b-aa5b-66eda461ec35

	/// Démissions de CDI sur 12 mois / effectif moyen CDI sur 12 mois.
	measure 'Resignation Rate 12M %' =
			VAR _end = MAX ( dim_date[month_start] )
			VAR _start = EDATE ( _end, -11 )
			VAR _n =
			    CALCULATE ( [Resignations CDI], REMOVEFILTERS ( dim_date ), dim_date[month_start] >= _start, dim_date[month_start] <= _end )
			RETURN
			    DIVIDE ( _n, [Avg Headcount CDI 12M] )
		formatString: 0.0 %
		displayFolder: Mouvements
		lineageTag: 86bcb847-7add-5dba-a0d0-a95ac6611c2d

	/// Toutes sorties sur 12 mois, CDD et alternants compris / effectif moyen sur 12 mois. Ne pas comparer au turnover CDI.
	measure 'Total Exit Rate 12M %' =
			VAR _end = MAX ( dim_date[month_start] )
			VAR _start = EDATE ( _end, -11 )
			VAR _n =
			    CALCULATE ( [Exits], REMOVEFILTERS ( dim_date ), dim_date[month_start] >= _start, dim_date[month_start] <= _end )
			RETURN
			    DIVIDE ( _n, [Avg Headcount 12M] )
		formatString: 0.0 %
		displayFolder: Mouvements
		lineageTag: 4adc5b1c-e556-5ad0-9f85-3fa14037ca91

	/// employee_id + event date + movement type
	column movement_id
		dataType: string
		isHidden
		lineageTag: 8fc8ef4a-30af-511b-b5d9-11b2a31953cb
		summarizeBy: none
		sourceColumn: movement_id

		annotation SummarizationSetBy = User

	/// Movement date; for an exit, last worked day (BEGDA - 1)
	column event_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3e3ff14c-931b-5545-87db-a0e040027af4
