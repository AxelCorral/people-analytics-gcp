# Copier en .env (ignoré par Git) et renseigner. Aucun secret ici :
# l'authentification passe par `gcloud auth application-default login`.

GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=europe-west1
BQ_DATASET_RAW=hr_raw
BQ_DATASET_STAGING=hr_staging
BQ_DATASET_INTERMEDIATE=hr_intermediate
BQ_DATASET_MARTS=hr_marts
BQ_MAX_BYTES_BILLED=1000000000

GENERATOR_SEED=42
GENERATOR_AS_OF_DATE=2026-09-30
GENERATOR_YEARS=3
# Laisser vide par défaut ; fixer (ex. 2023-10-01) pour simuler une extraction ultérieure du même historique
GENERATOR_START_DATE=
GENERATOR_OUTPUT_DIR=data/raw
