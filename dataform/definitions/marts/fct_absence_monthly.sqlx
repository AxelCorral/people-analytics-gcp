config {
  type: "table",
  schema: "hr_marts",
  tags: ["marts"],
  description: "Absence hours per employee, month, department and absence type (working days only). Numerator of the absenteeism rate (types with counts_in_absenteeism) and of the total absence rate (all types, paid leave and RTT included).",
  columns: {
    month_start: "First day of the month (relationship key to dim_date)",
    employee_id: "Personnel number",
    org_unit_id: "Department on the absence day",
    site_code: "Site on the absence day",
    absence_type_code: "AWART",
    absence_days: "Working days of absence in the month",
    absence_hours: "Hours of absence in the month"
  },
  assertions: {
    uniqueKey: ["month_start", "employee_id", "org_unit_id", "absence_type_code"],
    nonNull: ["month_start", "employee_id", "org_unit_id", "absence_type_code", "absence_hours"]
  }
}

SELECT
  DATE_TRUNC(d.absence_date, MONTH) AS month_start,
  d.employee_id,
  p.org_unit_id,
  p.site_code,
  d.absence_type_code,
  COUNT(*) AS absence_days,
  SUM(d.absence_hours) AS absence_hours
FROM ${ref("int_absence_days")} AS d
JOIN ${ref("int_employee_periods")} AS p
  ON p.employee_id = d.employee_id
  AND ${constants.inPeriod("d.absence_date", "p.period_start", "p.period_end")}
CROSS JOIN ${ref("int_extraction_context")} AS x
WHERE d.absence_date BETWEEN x.snapshot_start_date AND x.as_of_date
GROUP BY 1, 2, 3, 4, 5
